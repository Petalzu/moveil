MOVEIL_DEVICE=cuda
MOVEIL_NER_PYTHON=/usr/bin/python3
MOVEIL_APP_PYTHON=/opt/moveil-ocr-env/bin/python
MOVEIL_MODEL_DIR=/models/nvidia-gliner-pii
MOVEIL_OCR_BACKEND=ppocrv6-torch
MOVEIL_OCR_MODEL_DIR=/opt/moveil-ocr-models
MOVEIL_OCR_BATCH_SIZE=16
MOVEIL_NER_PRECISION=fp16
CUBLAS_WORKSPACE_CONFIG=:4096:8